{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5433;Database=kb;Username=kb;Password=kb_dev_password"
  },
  "Redis": {
    "ConnectionString": "localhost:6380"
  },
  "Auth": {
    "Authority": "http://localhost:8081/realms/kb",
    "Audience": "kb-api",
    "RequireHttpsMetadata": true
  },
  "Storage": {
    "RootPath": "data/blobs",
    "MaxUploadBytes": 26214400
  },
  "Ingestion": {
    "WorkerEnabled": true,
    "Concurrency": 2,
    "MaxAttempts": 5,
    "RetryBaseSeconds": 5
  },
  "Chat": {
    "TopK": 8,
    "ContextTokenBudget": 3000,
    "HistoryTokenBudget": 2000,
    "MaxAnswerTokens": 1024,
    "MinSimilarity": 0.2,
    "CacheEnabled": true,
    "CacheSimilarityThreshold": 0.97,
    "RequestsPerMinute": 20
  },
  "Llm": {
    "Provider": "extractive",
    "Anthropic": {
      "Model": "claude-opus-5-5",
      "Effort": "low"
    }
  },
  "Embeddings": {
    "Provider": "hashing"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "KeyPrefix": "rl"
  },
  "Idempotency": {
    "ResultTtlHours": 24,
    "LockSeconds": 30
  },
  "AllowedHosts": "*"
}
