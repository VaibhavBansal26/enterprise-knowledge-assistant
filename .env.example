# Copy to .env (git-ignored) and change every value.
POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# Public URL browsers use to reach Keycloak (must match the issuer in tokens).
KEYCLOAK_PUBLIC_URL=http://localhost:8081
WEB_PORT=8088
# extractive = offline stand-in; anthropic = real answers (needs ANTHROPIC_API_KEY).
LLM_PROVIDER=extractive
ANTHROPIC_API_KEY=
SENTRY_DSN=
OTLP_ENDPOINT=
TAG=local
