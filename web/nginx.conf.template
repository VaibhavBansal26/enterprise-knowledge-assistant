# Behind a TLS-terminating platform proxy the scheme arrives in X-Forwarded-Proto; when hit directly, use our own.
map $http_x_forwarded_proto $fwd_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen 8080;
  root /usr/share/nginx/html;
  client_max_body_size 25m;   # document uploads

  # Re-resolve the API's address every few seconds. With a literal proxy_pass nginx resolves it once at startup, so
  # after the API container is replaced every request would 502 until nginx restarted.
  resolver ${DNS_RESOLVER} valid=5s ipv6=off;
  set $api ${API_UPSTREAM};
  set $kc ${KEYCLOAK_UPSTREAM};

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location /api/ {
    proxy_pass $api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Chat answers stream over SSE: do not buffer.
    proxy_buffering off;
    proxy_read_timeout 300s;
  }

  location = /config.js {
    alias /tmp/config.js;   # generated at container start from environment variables
    add_header Cache-Control "no-store";
  }

  # Optional: Keycloak (started with KC_HTTP_RELATIVE_PATH=/auth) served from this origin, so the browser, the API
  # and the identity provider share one public URL and no CORS or issuer mismatch can arise.
  location /auth/ {
    proxy_pass $kc;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $http_host;   # includes the port when there is one
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
  }

  location /health/ { proxy_pass $api; }

  location /hubs/ {
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri /index.html;   # SPA fallback
    add_header Cache-Control "no-cache";
  }
}
